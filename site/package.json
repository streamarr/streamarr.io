{
  "name": "streamarr-io-site",
  "version": "0.1.0",
  "description": "The marketing site for Streamarr, prerendered from the CMS",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen:check": "npm run codegen && drift=\"$(git status --porcelain -- src/graphql/generated)\" && if [ -n \"$drift\" ]; then echo \"Generated GraphQL types drifted from cms/schema.graphql:\"; echo \"$drift\"; exit 1; fi"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "graphql": "^16.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "license": "GPL-3.0-only"
}
